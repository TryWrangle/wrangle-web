---
import TestimonialCarousel from '../ui/TestimonialCarousel';

const messages = [
  { text: 'WAIT you went to Fushimi Inari?? 😭', author: 'Aisha K.', side: 'left' },
  { text: 'How did I not know about this', author: 'Aisha K.', side: 'left' },
  { text: '🔗 Kyoto: Inari → Arashiyama guide', author: 'You', side: 'right', isLink: true },
  { text: 'bookmarking this for our Japan trip omg', author: 'Aisha K.', side: 'left' },
  { text: 'ok this is the best thing you\'ve ever sent me', author: 'Priya M.', side: 'left' },
];
---

<section
  id="social-chapter"
  class="py-24 md:py-32"
  style="background: radial-gradient(ellipse at 50% 0%, #1a2a6c 0%, #070e22 65%);"
>
  <div class="max-w-7xl mx-auto px-6">

    <!-- Section headline -->
    <h2
      class="font-display font-bold text-white text-center mb-16"
      style="font-size: clamp(28px, 4vw, 40px);"
    >
      Your friends have been waiting for this guide.
    </h2>

    <div class="flex flex-col md:flex-row items-start gap-12 md:gap-16">

      <!-- Left: Phone mockup -->
      <div class="flex-1 flex justify-center">
        <div
          style="
            width: 240px; height: 480px;
            background: var(--navy-800);
            border-radius: 36px;
            border: 3px solid rgba(255,255,255,0.1);
            box-shadow: 0 40px 80px rgba(0,0,0,0.5);
            overflow: hidden;
            position: relative;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            gap: 12px; padding: 40px 16px 16px;
          "
        >
          <div style="position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 80px; height: 20px; background: #000; border-radius: 12px;"></div>
          <!-- Cover photo -->
          <div style="width: 100%; height: 90px; border-radius: 12px; overflow: hidden; position: relative; flex-shrink: 0;">
            <img src="https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=400&q=80&fit=crop" alt="Fushimi Inari" style="width:100%;height:100%;object-fit:cover;display:block;" />
            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.6) 0%,transparent 60%);"></div>
          </div>
          <p style="font-family: 'Sora', sans-serif; font-weight: 700; font-size: 13px; color: white; text-align: center; line-height: 1.3; margin: -4px 0 0;">Fushimi Inari<br/>→ Arashiyama</p>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4px; width: 100%;">
            {[
              { src: 'https://images.unsplash.com/photo-1545569341-9eb8b30979d9?w=120&q=80&fit=crop', alt: 'Kyoto temple' },
              { src: 'https://images.unsplash.com/photo-1480796927426-f609979314bd?w=120&q=80&fit=crop', alt: 'Bamboo grove' },
              { src: 'https://images.unsplash.com/photo-1579871494447-9811cf80d66c?w=120&q=80&fit=crop', alt: 'Japanese food' },
              { src: 'https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=120&q=80&fit=crop', alt: 'Arashiyama' },
            ].map(p => (
              <div style="height: 60px; border-radius: 8px; overflow: hidden;">
                <img src={p.src} alt={p.alt} style="width:100%;height:100%;object-fit:cover;display:block;" />
              </div>
            ))}
          </div>
          <button
            style="width: 100%; background: #FF7A59; color: white; border: none; border-radius: 10px; padding: 10px; font-family: 'Sora', sans-serif; font-weight: 700; font-size: 13px; cursor: pointer;"
          >
            Share guide →
          </button>
        </div>
      </div>

      <!-- Right: iMessage thread -->
      <div class="flex-1">
        <div
          style="
            background: var(--navy-800);
            border-radius: 12px;
            padding: 24px;
            border: 1px solid rgba(255,255,255,0.08);
          "
        >
          <p class="font-body text-xs text-steel mb-4 text-center">Today 4:22 PM</p>

          <div id="message-thread" class="flex flex-col gap-3">
            {messages.map((msg, i) => (
              <div
                class={`chat-bubble chat-bubble-${i} flex ${msg.side === 'right' ? 'justify-end' : 'justify-start'}`}
                style="opacity: 0; transform: translateY(8px);"
              >
                <div
                  style={`
                    max-width: 75%;
                    padding: ${msg.isLink ? '12px' : '10px 14px'};
                    border-radius: ${msg.side === 'right' ? '18px 18px 4px 18px' : '18px 18px 18px 4px'};
                    background: ${msg.isLink ? '#FF7A59' : msg.side === 'right' ? '#4B7BEC' : 'rgba(255,255,255,0.08)'};
                    font-family: 'Manrope', sans-serif;
                    font-size: 13px;
                    color: white;
                    line-height: 1.5;
                  `}
                >
                  {msg.isLink ? (
                    <div>
                      <p style="font-weight: 700; font-size: 12px; margin-bottom: 2px; opacity: 0.8;">🔗 Wrangle Guide</p>
                      <p style="font-weight: 600;">{msg.text.replace('🔗 ', '')}</p>
                    </div>
                  ) : msg.text}
                  {msg.side === 'left' && (
                    <p style="font-size: 10px; opacity: 0.5; margin-top: 4px;">{msg.author}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Testimonials -->
        <TestimonialCarousel client:visible />
      </div>
    </div>
  </div>
</section>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    (async () => {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      ScrollTrigger.create({
        trigger: '#social-chapter',
        start: 'top 65%',
        onEnter: () => {
          const bubbles = document.querySelectorAll<HTMLElement>('[class*="chat-bubble-"]');
          gsap.to(bubbles, {
            opacity: 1, y: 0,
            duration: 0.4, stagger: 0.4,
            ease: 'power2.out',
          });
        },
      });
    })();
  }
</script>
