---
const flyingPhotos = [
  { src: 'https://images.unsplash.com/photo-1528360983277-13d401cdc186?w=104&q=80&fit=crop', alt: 'Kyoto' },
  { src: 'https://images.unsplash.com/photo-1431274172761-fcdab704a0ef?w=104&q=80&fit=crop', alt: 'Paris' },
  { src: 'https://images.unsplash.com/photo-1552832230-c0197dd311b5?w=104&q=80&fit=crop', alt: 'Rome' },
  { src: 'https://images.unsplash.com/photo-1503899036084-c55cdd92da26?w=104&q=80&fit=crop', alt: 'Tokyo' },
  { src: 'https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?w=104&q=80&fit=crop', alt: 'NYC' },
  { src: 'https://images.unsplash.com/photo-1573843981267-be1999ff37cd?w=104&q=80&fit=crop', alt: 'Bali' },
];
---

<section
  id="guide-chapter"
  class="relative overflow-hidden py-24 md:py-32"
  style="background: linear-gradient(135deg, #162550 0%, #1e3068 40%, #162550 100%);"
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center gap-16 md:gap-24">

      <!-- Left copy -->
      <div class="flex-1 md:max-w-[45%]">
        <h2
          class="font-display font-bold text-white"
          style="font-size: clamp(28px, 4vw, 44px); line-height: 1.15;"
        >
          From camera roll to guide in minutes.
        </h2>
        <p class="font-body text-steel mt-5 leading-relaxed" style="font-size: 17px; max-width: 420px;">
          Every photo, automatically placed. Every location, intelligently named. Every memory, ready to share with the people who matter.
        </p>

        <div class="flex flex-col gap-4 mt-8">
          {[
            { icon: '📍', label: 'Auto-tagged locations', sub: 'EXIF metadata + ML' },
            { icon: '✨', label: 'Smart curation', sub: 'Only the best shots' },
            { icon: '🔗', label: 'One-tap sharing', sub: 'Link, no app required' },
          ].map(item => (
            <div class="flex items-center gap-4">
              <div class="w-10 h-10 rounded-lg flex items-center justify-center text-lg flex-shrink-0"
                style="background: rgba(255,122,89,0.12);">
                {item.icon}
              </div>
              <div>
                <p class="font-body font-semibold text-sm text-white">{item.label}</p>
                <p class="font-body text-xs text-steel">{item.sub}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: Phone mockup with 3D -->
      <div class="flex-1 flex justify-center md:justify-end" style="perspective: 1200px;">
        <div
          id="phone-inner"
          style="
            width: 280px; height: 560px;
            transform: rotateY(-8deg) rotateX(4deg);
            transition: transform 0.4s ease;
            will-change: transform;
            position: relative;
          "
        >
          <!-- Phone shell -->
          <div
            style="
              width: 100%; height: 100%;
              background: #1a1a2e;
              border-radius: 36px;
              border: 3px solid rgba(255,255,255,0.12);
              box-shadow: 0 40px 80px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255,255,255,0.1);
              overflow: hidden;
              position: relative;
            "
          >
            <!-- Phone notch -->
            <div style="position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 90px; height: 24px; background: #000; border-radius: 12px; z-index: 10;"></div>

            <!-- Guide UI: Home screen -->
            <div id="guide-ui" style="position: absolute; inset: 0; padding: 48px 14px 14px; opacity: 0; display: flex; flex-direction: column; gap: 0; background: #0d1535;">

              <!-- Greeting -->
              <div class="guide-ui-item" style="opacity: 0; transform: translateY(8px); margin-bottom: 10px;">
                <p style="font-size: 9px; color: rgba(176,196,222,0.6); font-family: 'Manrope', sans-serif; margin: 0 0 2px;">Your guides, at a glance</p>
                <p style="font-size: 17px; font-weight: 800; color: white; font-family: 'Sora', sans-serif; margin: 0; letter-spacing: -0.03em;">Hi, Traveler 👋</p>
              </div>

              <!-- Get started card -->
              <div class="guide-ui-item" style="opacity: 0; transform: translateY(8px); background: rgba(26,42,108,0.7); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; padding: 14px 14px 12px; margin-bottom: 10px;">
                <p style="font-size: 14px; font-weight: 800; color: white; font-family: 'Sora', sans-serif; margin: 0 0 4px; letter-spacing: -0.02em;">Get started</p>
                <p style="font-size: 9px; color: rgba(176,196,222,0.7); font-family: 'Manrope', sans-serif; margin: 0 0 10px;">Create your first travel guide</p>
                <div style="background: #FF7A59; border-radius: 10px; padding: 8px 12px; display: flex; align-items: center; gap: 6px; margin-bottom: 6px;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="white" stroke="none"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                  <span style="font-size: 10px; font-weight: 700; color: white; font-family: 'Sora', sans-serif;">Create manually</span>
                </div>
                <div style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 8px 12px; display: flex; align-items: center; gap: 6px;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="rgba(176,196,222,0.8)" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  <span style="font-size: 10px; font-weight: 600; color: rgba(255,255,255,0.75); font-family: 'Manrope', sans-serif;">Auto-discover from photos</span>
                </div>
              </div>

              <!-- Feed card (guide published) -->
              <div class="guide-ui-item" style="opacity: 0; transform: translateY(8px); border-radius: 12px; overflow: hidden; position: relative; flex: 1; min-height: 0; background: url('https://images.unsplash.com/photo-1533106497176-45ae19e68ba2?w=300&q=80&fit=crop') center/cover no-repeat;">
                <div style="position: absolute; top: 8px; left: 8px; z-index: 2; width: 24px; height: 24px; background: white; border-radius: 6px; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                  <img src="/logo-w-blue.png" alt="W" style="width:18px;height:18px;object-fit:contain;display:block;" />
                </div>
                <div style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.88)); padding: 18px 10px 8px; z-index: 2;">
                  <p style="font-family: 'Manrope', sans-serif; font-size: 8px; color: rgba(255,255,255,0.55); margin: 0 0 2px;">@trywrangle published a new guide</p>
                  <p style="font-family: 'Sora', sans-serif; font-weight: 700; font-size: 13px; color: white; margin: 0;">Miami</p>
                  <p style="font-family: 'Manrope', sans-serif; font-size: 8px; color: rgba(255,255,255,0.45); margin: 2px 0 0;">9h ago</p>
                </div>
              </div>

            </div>
          </div>

          <!-- Floating photos that fly in -->
          {flyingPhotos.map((photo, i) => (
            <div
              class={`flying-photo flying-${i}`}
              style={`
                position: absolute;
                width: 52px; height: 52px;
                border-radius: 10px;
                overflow: hidden;
                border: 2px solid rgba(255,255,255,0.2);
                box-shadow: 0 8px 20px rgba(0,0,0,0.4);
                opacity: 0;
                top: ${80 + (i % 3) * 80}px;
                left: ${i % 2 === 0 ? '-60px' : 'auto'};
                right: ${i % 2 !== 0 ? '-60px' : 'auto'};
              `}
            >
              <img src={photo.src} alt={photo.alt} style="width:100%;height:100%;object-fit:cover;display:block;" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    (async () => {
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      const section = document.getElementById('guide-chapter');
      const phone = document.getElementById('phone-inner');
      const guideUI = document.getElementById('guide-ui');
      if (!section || !phone || !guideUI) return;

      // Mouse parallax
      section.addEventListener('mousemove', (e) => {
        const rect = section.getBoundingClientRect();
        const nx = (e.clientX - rect.left) / rect.width;
        const ny = (e.clientY - rect.top) / rect.height;
        phone.style.transform = `rotateY(${(nx - 0.5) * -8}deg) rotateX(${(ny - 0.5) * 8}deg)`;
      });
      section.addEventListener('mouseleave', () => {
        gsap.to(phone, { rotateY: -8, rotateX: 4, duration: 0.6, ease: 'power2.out' });
      });

      // Scroll-triggered animation
      ScrollTrigger.create({
        trigger: '#guide-chapter',
        start: 'top 70%',
        onEnter: () => {
          const flyingPhotos = document.querySelectorAll<HTMLElement>('.flying-photo');
          const uiItems = document.querySelectorAll<HTMLElement>('.guide-ui-item');

          // Photos fly in
          gsap.to(flyingPhotos, {
            x: (i) => (i % 2 === 0 ? 40 : -40),
            scale: 1, opacity: 1,
            duration: 0.7, ease: 'back.out(1.4)',
            stagger: 0.12,
          });

          // Guide UI fades in
          setTimeout(() => {
            guideUI!.style.opacity = '1';
            gsap.to(uiItems, {
              opacity: 1, y: 0,
              duration: 0.5, stagger: 0.15,
              delay: 0.8,
            });
          }, 800);
        },
      });
    })();
  }
</script>
