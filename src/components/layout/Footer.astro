---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
  { href: '/press', label: 'Press' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<footer class="bg-navy-900 border-t border-white/10 pt-12 pb-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 mb-10">
      <!-- Brand -->
      <div class="flex flex-col gap-2">
        <a href="/" class="flex items-center gap-2 no-underline">
          <div class="w-7 h-7 flex items-center justify-center overflow-hidden" style="background: white; border-radius: 7px;">
            <img src="/logo-w-blue.png" alt="Wrangle" style="width: 20px; height: 20px; object-fit: contain; display: block;" />
          </div>
          <span class="font-display font-bold text-lg text-white tracking-tight">Wrangle</span>
        </a>
        <p class="font-body text-sm text-steel">Travel smarter. Share better.</p>
      </div>

      <!-- Nav links -->
      <nav class="flex flex-wrap gap-x-6 gap-y-3">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="font-body text-sm text-steel hover:text-white transition-colors no-underline"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Social + contact -->
      <div class="flex flex-col gap-3">
        <div class="flex items-center gap-4">
          <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="text-steel hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener" aria-label="TikTok" class="text-steel hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.19 8.19 0 004.79 1.53V6.76a4.85 4.85 0 01-1.02-.07z"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="Twitter/X" class="text-steel hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
        <a href="mailto:hello@getwrangle.app" class="font-body text-sm text-steel hover:text-white transition-colors no-underline">
          hello@getwrangle.app
        </a>
      </div>
    </div>

    <div class="border-t border-white/10 pt-6">
      <p class="text-center font-body text-xs text-steel/60">
        © 2026 Wrangle. All rights reserved.
      </p>
    </div>
  </div>
</footer>
