---
interface Props {
  title: string;
  description: string;
  slug: string;
  tag: string;
  readTime: string;
  pubDate: Date;
  coverEmoji: string;
  coverImage?: string;
  author: string;
}
const { title, description, slug, tag, readTime, pubDate, coverEmoji, coverImage, author } = Astro.props;

const dateStr = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---

<a
  href={`/blog/${slug}`}
  class="group block no-underline"
  style="
    background: var(--navy-800);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  "
  onmouseover="this.style.borderColor='rgba(255,122,89,0.4)'; this.style.transform='translateY(-2px)'"
  onmouseout="this.style.borderColor='rgba(255,255,255,0.08)'; this.style.transform='translateY(0)'"
>
  <!-- Cover area -->
  <div style="height: 160px; position: relative; overflow: hidden;">
    {coverImage ? (
      <img src={coverImage} alt={title} style="width:100%;height:100%;object-fit:cover;display:block;" />
    ) : (
      <div style="width:100%;height:100%;background: linear-gradient(135deg, var(--navy-700), var(--navy-900)); display:flex;align-items:center;justify-content:center;font-size:64px;">
        {coverEmoji}
      </div>
    )}
  </div>

  <div style="padding: 20px;">
    <!-- Tag pill -->
    <span
      style="
        display: inline-block;
        background: rgba(255,122,89,0.15);
        color: #FF7A59;
        font-family: 'Manrope', sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 99px;
        margin-bottom: 10px;
      "
    >
      {tag}
    </span>

    <!-- Title -->
    <h3
      style="
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: 18px;
        color: white;
        line-height: 1.3;
        margin: 0 0 8px;
      "
    >
      {title}
    </h3>

    <!-- Excerpt -->
    <p
      style="
        font-family: 'Manrope', sans-serif;
        font-size: 13px;
        color: #B0C4DE;
        line-height: 1.6;
        margin: 0 0 16px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      "
    >
      {description}
    </p>

    <!-- Meta -->
    <div style="display: flex; align-items: center; justify-content: space-between;">
      <span style="font-family: 'Manrope', sans-serif; font-size: 12px; color: rgba(176,196,222,0.6);">
        {author}
      </span>
      <div style="display: flex; align-items: center; gap: 8px;">
        <span style="font-family: 'Manrope', sans-serif; font-size: 12px; color: rgba(176,196,222,0.6);">{readTime}</span>
        <span style="color: rgba(176,196,222,0.3);">·</span>
        <span style="font-family: 'Manrope', sans-serif; font-size: 12px; color: rgba(176,196,222,0.6);">{dateStr}</span>
      </div>
    </div>
  </div>
</a>
