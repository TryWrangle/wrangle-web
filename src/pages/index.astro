---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import MapChapter from '../components/sections/MapChapter.astro';
import CurationChapter from '../components/sections/CurationChapter.astro';
import GuideChapter from '../components/sections/GuideChapter.astro';
import SocialChapter from '../components/sections/SocialChapter.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
---

<BaseLayout
  title="Wrangle — Turn Your Travel Photos Into Shareable Guides"
  description="Wrangle uses ML to curate your camera roll into beautiful travel guides you'll actually share. No typing, no tagging. Join the waitlist."
>
  <Fragment slot="head">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "url": "https://trywrangle.com/",
        "name": "Wrangle — Turn Your Travel Photos Into Shareable Guides",
        "description": "Wrangle uses ML to curate your camera roll into beautiful travel guides you'll actually share. No typing, no tagging."
      }
    </script>
  </Fragment>

  <Nav />
  <main>
    <Hero />
    <MapChapter />
    <CurationChapter />
    <GuideChapter />
    <SocialChapter />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
