---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Wrangle turns your travel photos into shareable micro-guides using ML-powered curation. No live GPS. No typing. Just your camera roll.',
  ogImage = '/logo-w.png',
  ogType = 'website',
} = Astro.props;

const siteURL = 'https://trywrangle.com';
const canonicalURL = new URL(Astro.url.pathname, Astro.site || siteURL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0E1B42" />
    <meta name="msapplication-TileColor" content="#0E1B42" />

    <!-- SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Wrangle" />
    <meta name="application-name" content="Wrangle" />
    <meta name="keywords" content="travel guide app, camera roll, travel photos, auto travel guide, trip planner, shareable travel guide" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Wrangle" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@getwrangle" />
    <meta name="twitter:creator" content="@getwrangle" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL).href} />

    <!-- Structured data: WebSite + Organization + SoftwareApplication (global) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": "Wrangle",
          "url": siteURL,
          "description": "Turn your travel photos into shareable travel guides"
        },
        {
          "@type": "Organization",
          "name": "Wrangle",
          "url": siteURL,
          "logo": {
            "@type": "ImageObject",
            "url": `${siteURL}/logo-w.png`
          },
          "sameAs": [
            "https://twitter.com/getwrangle",
            "https://www.instagram.com/getwrangle"
          ]
        },
        {
          "@type": "SoftwareApplication",
          "name": "Wrangle",
          "description": description,
          "url": siteURL,
          "applicationCategory": "TravelApplication",
          "operatingSystem": "iOS, Android",
          "offers": { "@type": "Offer", "price": "0" },
          "publisher": { "@type": "Organization", "name": "Wrangle", "url": siteURL }
        }
      ]
    })} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@700;800&family=Manrope:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <ViewTransitions />

    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Lenis smooth scroll -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // Use native scroll — Lenis lerp fights macOS trackpad momentum
      ScrollTrigger.defaults({ scroller: window });
    </script>

    <!-- Magnetic button behavior -->
    <script>
      function initMagnetic() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.querySelectorAll<HTMLElement>('.btn-magnetic').forEach((el) => {
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const dx = e.clientX - (r.left + r.width / 2);
            const dy = e.clientY - (r.top + r.height / 2);
            const dist = Math.hypot(dx, dy);
            if (dist < 80) {
              const f = (80 - dist) / 80;
              el.style.transform = `translate(${dx * f * 0.35}px, ${dy * f * 0.35}px)`;
            }
          });
          el.addEventListener('mouseleave', async () => {
            const { gsap } = await import('gsap');
            gsap.to(el, { x: 0, y: 0, duration: 0.4, ease: 'elastic.out(1, 0.4)' });
          });
        });
      }
      document.addEventListener('DOMContentLoaded', initMagnetic);
    </script>
  </body>
</html>
